# Copy to .env (or set in your platform) - every value has a safe local default.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=rightpoint.co.ke,www.rightpoint.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://rightpoint.co.ke,https://www.rightpoint.co.ke
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

SITE_URL=https://rightpoint.co.ke

# Database - defaults to sqlite3 at ./db.sqlite3
#DJANGO_DB_ENGINE=django.db.backends.postgresql
#DJANGO_DB_NAME=rightpoint
#DJANGO_DB_USER=rightpoint
#DJANGO_DB_PASSWORD=
#DJANGO_DB_HOST=
#DJANGO_DB_PORT=5432

# Cache (optional, falls back to in-memory)
#DJANGO_REDIS_URL=redis://localhost:6379/1

# Email - defaults to writing messages to the console in development
#DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#DJANGO_EMAIL_HOST=smtp.zoho.com
#DJANGO_EMAIL_PORT=587
#DJANGO_EMAIL_HOST_USER=enquiries@rightpoint.co.ke
#DJANGO_EMAIL_HOST_PASSWORD=
#DJANGO_EMAIL_USE_TLS=True
#DEFAULT_FROM_EMAIL=Right Point Solutions <enquiries@rightpoint.co.ke>
ENQUIRY_NOTIFY_EMAILS=rightpointsolutionske@gmail.com
